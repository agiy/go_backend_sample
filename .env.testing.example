APP_NAME=go_backend_sample
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:3000
APP_HOST=127.0.0.1
APP_PORT=3000
LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=15432
DB_DATABASE=go_backend_sample_test
DB_USERNAME=goravel
DB_PASSWORD=goravel_local
DB_SSLMODE=disable
DB_SCHEMA=public
DB_MAX_IDLE_CONNS=5
DB_MAX_OPEN_CONNS=20
DB_CONN_MAX_IDLETIME=300
DB_CONN_MAX_LIFETIME=1800

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE=false
